server {
    listen 443 ssl http2;
    server_name example.com;
    # ssl_certificate / ssl_certificate_key ...

    root /srv/portfolio/current;
    index index.html;

    # Old URLs from the previous site
    location = /projects { return 301 /work/; }
    location = /projects/ { return 301 /work/; }
    location ^~ /blog { return 301 /notes/; }

    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }
    error_page 404 /404.html;
}

# The admin is NOT exposed here. It listens on 127.0.0.1:4310 only;
# reach it with:  ssh -L 4310:127.0.0.1:4310 you@server
